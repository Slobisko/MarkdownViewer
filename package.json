{
  "name": "markdown-viewer",
  "version": "1.1.0",
  "description": "Jednoduchý prohlížeč Markdown souborů se záložkami",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Slobisko/MarkdownViewer.git"
  },
  "keywords": [],
  "author": "Jan Oršl",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Slobisko/MarkdownViewer/issues"
  },
  "homepage": "https://github.com/Slobisko/MarkdownViewer#readme",
  "dependencies": {
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "cz.slobisko.markdownviewer",
    "productName": "Markdown Viewer",
    "copyright": "Copyright © 2026 Jan Oršl",
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "icon.png",
      "node_modules/marked/lib/marked.umd.js"
    ],
    "win": {
      "icon": "icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "role": "Viewer"
      }
    ]
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
